<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS du site vitrine NovaLink Togo (site IIS « PPE301 », C:\inetpub\ppe301, http://www.ipnet.local).
  Site statique : aucun module supplémentaire requis (pas de URL Rewrite).
  Sections utilisées (déléguées au niveau du site dans une installation IIS par défaut) :
  defaultDocument, directoryBrowse, staticContent, httpProtocol, httpErrors, security/requestFiltering.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- Types MIME : remove puis add pour éviter une erreur de doublon si le type existe déjà au niveau serveur -->
    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- Ne jamais servir les documents de projet s'ils sont copiés par erreur dans le dossier du site -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".docx" />
          <add fileExtension=".docx" allowed="false" />
          <remove fileExtension=".pptx" />
          <add fileExtension=".pptx" allowed="false" />
          <remove fileExtension=".drawio" />
          <add fileExtension=".drawio" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- En-têtes de sécurité (pas de HSTS : le site local est en HTTP) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>

    <!-- Page 404 personnalisée (erreurs détaillées conservées sur le serveur lui-même) -->
    <httpErrors>
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" prefixLanguageFilePath="" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
